<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds may also reach a development server on the local network over HTTP. -->
<!-- Intentional for debug builds only; release builds use src/main's HTTPS-only config. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
