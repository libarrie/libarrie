# Copy to .env (never commit it) and fill in every value that has none.
# docs/self-hosting.md explains each step.

# Release to run: a published version tag, such as 0.1.0.
LIBARRIE_VERSION=

# Two DNS names pointing at this machine: the app and its file storage.
LIBARRIE_DOMAIN=notes.example.com
LIBARRIE_FILES_DOMAIN=files.notes.example.com

# Secrets. Generate each with: openssl rand -hex 32
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# A key ID and a secret, such as k1:<openssl rand -hex 32>. Keep it: a
# deleted account's sign-in is recorded under it, so its usage carries over
# if the same person signs up again. To rotate, list the new key next to the
# old one (comma-separated, at most three) and keep both.
IDENTITY_HASH_KEYS=

# Your identity provider (OpenID Connect). Register a web client with the
# redirect URI https://<LIBARRIE_DOMAIN>/auth/callback.
OIDC_ISSUER=https://auth.example.com
OIDC_JWKS_URL=https://auth.example.com/.well-known/jwks.json
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Your sign-in subject (the `sub` claim), made an owner when you sign in.
# Leave empty to claim ownership with the setup code in the API's log.
LIBARRIE_OWNER=

# Optional: the iOS and Android apps (a public PKCE client with the redirect
# URI libarrie://oauth/callback) and the audience of their access tokens.
OIDC_NATIVE_CLIENT_ID=
OIDC_AUDIENCE=
# Optional: agents signing in to the MCP server with OAuth. Access tokens
# need this audience; it defaults to https://<LIBARRIE_DOMAIN>/mcp.
# Must differ from OIDC_AUDIENCE; Libarrie refuses to start otherwise.
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_SCOPES=

# Handwriting recognition (Mistral) and search (Voyage AI).
MISTRAL_API_KEY=
VOYAGE_API_KEY=
# Daily spending ceilings for those services, in millionths of a US dollar.
SPEND_ACCOUNT_DAILY_MICROS=5000000
SPEND_DEPLOYMENT_DAILY_MICROS=50000000

# Optional: another S3-compatible store instead of the bundled one, such as
# Cloudflare R2 (then also set S3_UPLOAD_INTEGRITY=md5).
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=libarrie
# S3_UPLOAD_INTEGRITY=md5
# Optional: a separate store for the lifecycle journal (recommended with R2).
# JOURNAL_S3_ENDPOINT=
# JOURNAL_S3_REGION=
# JOURNAL_S3_BUCKET=libarrie-journal
# JOURNAL_S3_ACCESS_KEY_ID=
# JOURNAL_S3_SECRET_ACCESS_KEY=

# Optional limits per account; unlimited by default.
# DEFAULT_STORED_PAGES=unlimited
# DEFAULT_NOTEBOOKS=unlimited
# DEFAULT_LIFETIME_PROCESSING=unlimited

# Image decoding sandbox: unprivileged (Linux 5.13+ with Landlock) or
# minijail (needs CAP_SYS_ADMIN for the worker).
# DECODER_SANDBOX=unprivileged
